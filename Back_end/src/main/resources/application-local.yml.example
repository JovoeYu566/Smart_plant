# 复制为 application-local.yml 并按本机修改（该文件已被 gitignore）
spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/smart_plant?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: root
    password: your_mysql_password

smart-plant:
  jwt:
    secret: "please-change-to-a-long-random-secret"
  gateway:
    api-key: "your-gateway-api-key"
  mqtt:
    username: "your_emqx_user"
    password: "your_emqx_password"
    client-id: "smart-plant-backend-local"
